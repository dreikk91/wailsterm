// VNC only styling — the session layout (control bar, viewport, fit mode)
// lives in the shared remote session shell: common/remote-session-shell.styl
.vnc-session-wrap
  .vnc-session-mount
    // noVNC mounts its own screen element in here and sizes its canvas
    // against this box, so it has to keep a definite size
    width 100%
    height 100%
    // noVNC's screen element carries no class of its own: letterbox area
    // follows the app theme instead of noVNC's own background
    > div
      background transparent !important
      // scrolled when fit is off and the remote screen is bigger than
      // the window
      &::-webkit-scrollbar
        width 16px
        height 16px
        background var(--main-darker)
      &::-webkit-scrollbar-track
        background var(--main-darker)
        box-shadow inset 0 0 5px var(--main-darker)
      &::-webkit-scrollbar-thumb
        background var(--primary)
        border-radius 0
      &::-webkit-scrollbar-corner
        background var(--main-darker)

// file manager drawer header: transfer progress, the sidebar's transfer icon and the fullscreen toggle in one row
.vnc-files-extra
  display flex
  align-items center
  .control-icon-wrap
    height auto
    width auto
    padding 0 4px
    line-height 1
    .font20
      font-size 16px
