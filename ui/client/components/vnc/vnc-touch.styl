// touch control for vnc, see vnc-touch.jsx

.vnc-session-mount
  // gestures are ours, the browser must not pan or zoom the page
  touch-action none

// a zoomed desktop pans by pushing the cursor at an edge, scrollbars only eat room
@media (pointer: coarse)
  .vnc-session-wrap .vnc-session-mount > div
    scrollbar-width none
    &::-webkit-scrollbar
      display none

// typed into while the soft keyboard is up; at the top so the browser never scrolls to it
.vnc-touch-input
  position fixed
  top 0
  left 0
  width 1px
  height 1px
  opacity 0
  border 0
  padding 0
  resize none
  font-size 16px // smaller makes iOS zoom the page on focus

// floating panel at the top of the desktop (RealVNC style); collapsed to a tab.
// Specific enough to beat the shell's fit rule sizing every viewport child.
.vnc-session-wrap .remote-session-viewport > .vnc-touch-panel
  width auto
  height auto
  flex none

.vnc-touch-panel
  position absolute
  top 6px
  left 50%
  transform translateX(-50%)
  z-index 500
  display flex
  align-items center
  gap 2px
  padding 4px 10px
  border-radius 28px
  border 2px solid rgba(255, 255, 255, 0.35)
  background rgba(0, 0, 0, 0.75)
  color #fff
  font-size 22px
  user-select none
  touch-action manipulation
  &.collapsed
    top 0
    padding 0 18px
    border-top 0
    border-radius 0 0 14px 14px
    font-size 14px
    line-height 22px
    opacity 0.7

.vnc-touch-panel-btn
  display flex
  align-items center
  justify-content center
  width 44px
  height 40px
  border-radius 20px
  &.active
    background var(--primary)

.vnc-touch-panel-kb
  font-size 26px
  line-height 1

.vnc-touch-bar
  position fixed
  left 0
  right 0
  z-index 1000
  display flex
  gap 4px
  padding 4px
  box-sizing border-box
  overflow-x auto
  background var(--main-darker)
  touch-action pan-x

.vnc-touch-key
  flex 0 0 auto
  min-width 44px
  padding 0 8px
  border 0
  border-radius 4px
  color var(--text)
  background var(--main)
  font-size 14px
  user-select none
  &.active
    color var(--main)
    background var(--primary)
